# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Groq LLM ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# Paper generation uses strict structured output and a larger free-tier TPM allowance.
GROQ_PAPER_MODEL=openai/gpt-oss-20b

# Optional legacy Anthropic key. Leave blank when using Groq.
ANTHROPIC_API_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Used inside Docker network (keep hostname as "postgres")
DATABASE_URL=postgresql://vidyaai:your_db_password@postgres:5432/vidyaai_db

# For running ingestion scripts on the HOST machine:
# DATABASE_URL_LOCAL=postgresql://vidyaai:your_db_password@localhost:5432/vidyaai_db

# ── Qdrant ─────────────────────────────────────────────────────────────────────
# Used inside Docker network (keep hostname as "qdrant")
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Use real multilingual embeddings for Hindi retrieval accuracy
USE_MOCK_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ALLOW_EMBEDDING_DOWNLOAD=false

# ── Admin Access ───────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@yourdomain.com

# ── CORS ───────────────────────────────────────────────────────────────────────
# Frontend origin (update to your production domain in production)
CORS_ORIGINS=http://localhost:5173
